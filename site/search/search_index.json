{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u9996\u9875","text":""},{"location":"#\u7b97\u5b50\u5f00\u53d1\u521b\u65b0\u5927\u8d5b","title":"\u7b97\u5b50\u5f00\u53d1\u521b\u65b0\u5927\u8d5b","text":"<p>\u8bf4\u660e</p> <p>\u672c\u4e3b\u9875\u4e3a 2026 \u4e2d\u56fd\u79d1\u5b66\u6280\u672f\u5927\u5b66\u7b97\u5b50\u5f00\u53d1\u521b\u65b0\u5927\u8d5b\u7684\u4e3b\u9875\uff0c\u5305\u542b\u4e86\u8d5b\u9898\u4e0e\u6559\u7a0b\u7684\u76f8\u5173\u4fe1\u606f\u3002</p> <p>\u516c\u544a</p> <p>\u4efb\u52a13 -- \u7efc\u5408\u7b97\u5b50 -- Paged Attention  \u5df2\u53d1\u5e03</p> <p>\u516c\u544a</p> <p>\u5927\u8d5b\u7684\u5956\u52b1\u673a\u5236\u5df2\u66f4\u65b0\uff01\u6ed1\u52a8\u5230\u672c\u9875\u4e0b\u65b9\u67e5\u770b~(\u25cf\u2032\u2200\uff40\u25cf)</p>"},{"location":"#\u7ade\u8d5b\u7b80\u4ecb","title":"\u7ade\u8d5b\u7b80\u4ecb","text":""},{"location":"#\u4e00\u5927\u8d5b\u6838\u5fc3","title":"\u4e00\u3001\u5927\u8d5b\u6838\u5fc3","text":"<p>\u7b97\u5b50\uff0c\u662f\u9a71\u52a8\u4eba\u5de5\u667a\u80fd\u6a21\u578b\u7684\u6700\u7ec8\u6267\u884c\u5355\u5143\uff0c\u662f\u8fde\u63a5\u7b97\u6cd5\u521b\u65b0\u4e0e\u786c\u4ef6\u7b97\u529b\u7684\u6838\u5fc3\u57fa\u7840\u3002\u4e3a\u54cd\u5e94\u56fd\u5bb6\u53d1\u5c55\u81ea\u4e3bAI\u7b97\u529b\u751f\u6001\u7684\u6218\u7565\u9700\u6c42\uff0c\u57f9\u517b\u638c\u63e1\u6838\u5fc3\u6280\u672f\u7684\u540e\u5907\u4eba\u624d\uff0c\u7279\u4e3e\u529e\u672c\u6b21\u5927\u8d5b\u3002\u6211\u4eec\u8bda\u9080\u6709\u5fd7\u5b66\u5b50\uff0c\u6295\u8eab\u4e8e\u56fd\u4ea7\u82af\u7247\u7684\u7b97\u5b50\u5f00\u53d1\u524d\u6cbf\uff0c\u4f18\u5316\u7b97\u529b\uff0c\u5171\u540c\u6784\u7b51\u4e2d\u56fdAI\u7684\u575a\u5b9e\u5e95\u5ea7\u3002</p>"},{"location":"#\u4e8c\u805a\u7126\u524d\u6cbf","title":"\u4e8c\u3001\u805a\u7126\u524d\u6cbf","text":"<p>\u672c\u5c4a\u5927\u8d5b\u805a\u7126 \u201c\u57fa\u4e8eTriton\u4e0eTileLang\u5148\u8fdb\u7f16\u8bd1\u6280\u672f\u7684\u9ad8\u6027\u80fd\u7b97\u5b50\u5f00\u53d1\u201d\uff0c\u8fd9\u662f\u63d0\u5347\u56fd\u4ea7AI\u82af\u7247\u5b9e\u9645\u6548\u80fd\u3001\u53d1\u5c55\u56fd\u4ea7\u5927\u6a21\u578b\u751f\u6001\u7684\u5173\u952e\u8def\u5f84\u3002\u4f17\u591a\u5934\u90e8\u4f01\u4e1a\u4e0e\u56e2\u961f\uff08\u5982DeepSeekV3.2\uff09\u5df2\u5728\u6b64\u9886\u57df\u6df1\u8015\uff0c\u53c2\u4e0e\u5927\u8d5b\u5373\u610f\u5473\u7740\u76f4\u63a5\u89e6\u78b0\u4ea7\u4e1a\u6700\u6838\u5fc3\u7684\u6311\u6218\uff0c\u7528\u5148\u8fdb\u6280\u672f\u91ca\u653e\u786c\u4ef6\u6f5c\u80fd\u3002</p>"},{"location":"#\u4e09\u4f60\u5c06\u83b7\u5f97","title":"\u4e09\u3001\u4f60\u5c06\u83b7\u5f97","text":"<ul> <li>\u771f\u67aa\u5b9e\u7ec3\uff1a\u5728\u771f\u5b9e\u6607\u817e\u7b97\u529b\u73af\u5883\u4e2d\uff0c\u83b7\u5f97\u4ece\u7b97\u5b50\u8bbe\u8ba1\u5230\u6027\u80fd\u8c03\u4f18\u7684\u5168\u6d41\u7a0b\u5de5\u4e1a\u7ea7\u7ecf\u9a8c\u3002</li> <li>\u5168\u529b\u652f\u6301\uff1a\u7ec4\u59d4\u4f1a\u63d0\u4f9b\u5145\u8db3\u7684\u514d\u8d39\u7b97\u529b\u3001\u6280\u672f\u6587\u6863\u53ca\u8d44\u6df1\u5de5\u7a0b\u5e08\u7684\u5168\u7a0b\u8f85\u5bfc\u3002</li> <li>\u5353\u8d8a\u524d\u7a0b\uff1a\u4f18\u79c0\u9009\u624b\u53ef\u83b7\u5f97\u4e30\u539a\u5956\u91d1\uff0c\u5e76\u83b7\u5f97\u5411\u9876\u5c16\u4f01\u4e1a\u53ca\u7814\u7a76\u673a\u6784\u7684\u5b9e\u4e60\u4e0e\u6df1\u9020\u63a8\u8350\u673a\u4f1a\u3002</li> </ul> <p>\u52a0\u5165\u6211\u4eec\uff0c\u4ece\u57fa\u7840\u505a\u8d77\uff0c\u5b9a\u4e49AI\u7684\u672a\u6765\u6548\u7387\uff01</p>"},{"location":"#\u53c2\u8d5b\u5bf9\u8c61","title":"\u53c2\u8d5b\u5bf9\u8c61","text":"<p>\u4e2d\u56fd\u79d1\u5b66\u6280\u672f\u5927\u5b66\u5168\u6821\u5728\u8bfb\u672c\u79d1\u751f\u3002</p>"},{"location":"#\u65f6\u95f4\u5b89\u6392","title":"\u65f6\u95f4\u5b89\u6392","text":"<ul> <li>2026-01-12 to 2026-01-18\uff1a\u9009\u624b\u62a5\u540d</li> <li>2026-01-21 to 2026-02-03\uff1a\u57f9\u8bad\u57fa\u78